#!/bin/sh
# fill an esp dir: systemd-boot plus a uki per kernel
# usage: slipspace-esp <esp-dir>
set -eu
esp=${1:?usage: slipspace-esp <esp-dir>}
efi=/usr/lib/systemd/boot/efi/systemd-bootx64.efi

install -D "$efi" "$esp/EFI/BOOT/BOOTX64.EFI"
install -D "$efi" "$esp/EFI/systemd/systemd-bootx64.efi"
mkdir -p "$esp/EFI/Linux" "$esp/loader"

for dir in /usr/lib/modules/*/; do
    kver=$(basename "$dir")
    # fedora: next to modules, debian/ubuntu: /boot
    image="${dir}vmlinuz"
    [ -e "$image" ] || image="/boot/vmlinuz-$kver"
    env -u KERNEL_INSTALL_BYPASS BOOT_ROOT="$esp" kernel-install add "$kver" "$image"
    # the uki has its own initrd
    rm -f "/boot/initrd.img-$kver"
done
